{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chessandwhatever",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "containers": [
    {
      "class_name": "GameServer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./backend1/Dockerfile",
          "build_context": "./backend1"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "GameServer" }]
  },
  "exports": {
    "GameServer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "FRONTEND_URL": "https://gambit-mocha.vercel.app",
    "ALLOWED_ORIGINS": "https://gambit-mocha.vercel.app,https://chessandwhatever.codealisha99.workers.dev,http://localhost:5173"
  },
  "observability": { "enabled": true }
}
