{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gambit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "containers": [
    {
      "class_name": "GameServer",
      "image": "./backend1/Dockerfile",
      "image_build_context": "./backend1",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "GameServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameServer"] }],
  // public origin, used for password-reset links and the Google sign-in redirect
  "vars": { "FRONTEND_URL": "https://gambit.codealisha99.workers.dev" },
  "observability": { "enabled": true }
}
